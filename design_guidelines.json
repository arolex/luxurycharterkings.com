    ],
    "cars": [
      "https://images.unsplash.com/photo-1679506640590-f0152786dff0?crop=entropy&cs=srgb&fm=jpg&q=85",
      "https://images.unsplash.com/photo-1638686302275-0e87df720aca?crop=entropy&cs=srgb&fm=jpg&q=85",
      "https://images.unsplash.com/photo-1549632891-a0bea6d0355b?crop=entropy&cs=srgb&fm=jpg&q=85"
    ],
    "villas": [
      "https://images.unsplash.com/photo-1613977257363-707ba9348227?crop=entropy&cs=srgb&fm=jpg&q=85"
    ],
    "tours": [
      "https://images.unsplash.com/photo-1544551763-46a013bb70d5?crop=entropy&cs=srgb&fm=jpg&q=85"
    ],
    "vip": [
      "https://images.unsplash.com/photo-1661954864180-e61dea14208a?crop=entropy&cs=srgb&fm=jpg&q=85"
    ]
  },
  "instructions_to_main_agent": [
    "Ensure ALL React component files are .js/.jsx as appropriate in the codebase",
    "Implement the exact color variables in index.css and tailwind.config.js for deep botanical green, soft sage, warm sand, stone, and copper",
    "Never add Helicopter or Hotel menu items or cards anywhere in the app",
    "Never use sales words like 'Buy Now', 'For Sale', or 'Dealer' on Luxury Cars or any other section; strictly use 'Rental', 'Daily Rate', 'Request to Book', 'Charter'",
    "Add data-testid to every interactive element (buttons, links, form fields, chat toggles, cards)",
    "Implement the live Concierge chat widget as a global floating overlay accessible from any page",
    "Use Lucide-react icons for luxury specs (Users, Compass, Shield, Key, Clock, MapPin, Sparkles, MessageSquare)"
  ]
}